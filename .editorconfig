# Editor settings shared by everyone working on the repository (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,mjs,json,html,css,yml,yaml,toml,md,cpp,hpp,h,c,cmake}]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
