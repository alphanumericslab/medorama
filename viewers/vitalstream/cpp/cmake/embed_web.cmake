# cmake -DWEB_DIR=... -DOUT=... -P embed_web.cmake
# Writes a C++ source defining vitalstream::web::files(): path -> bytes for every file of WEB_DIR
# (README.md excluded).

file(GLOB_RECURSE files RELATIVE "${WEB_DIR}" "${WEB_DIR}/*")
list(FILTER files EXCLUDE REGEX "README\\.md$")
list(SORT files)
set(body "// Generated by cpp/cmake/embed_web.cmake from web/: do not edit.\n")
string(APPEND body "#include <map>\n#include <string>\n#include <string_view>\n\n")
string(APPEND body "namespace vitalstream::web {\n\nnamespace {\n")
set(i 0)
set(table "")
foreach(f ${files})
  file(READ "${WEB_DIR}/${f}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR bytes "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(APPEND body "const unsigned char f${i}[] = {${hex}0};\n")
  string(APPEND table "      {\"${f}\", std::string_view(reinterpret_cast<const char*>(f${i}), ${bytes})},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "}  // namespace\n\n")
string(APPEND body "const std::map<std::string, std::string_view>& files() {\n")
string(APPEND body "  static const std::map<std::string, std::string_view> m = {\n${table}  };\n  return m;\n}\n\n")
string(APPEND body "}  // namespace vitalstream::web\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
